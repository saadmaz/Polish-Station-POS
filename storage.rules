rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // ── Identity helpers ──────────────────────────────────────────────────
    // Mirrors firestore.rules' identity/module helpers exactly (role/perms
    // are the same custom claims on the same ID token) — the two rule files
    // are independently hand-synced, same precedent as job.ts's
    // LEGAL_TRANSITIONS vs. firestore.rules' own copy of that table.
    function isAuth()   { return request.auth != null; }
    function role()     { return request.auth.token.role; }
    function isSuperAdmin()     { return isAuth() && role() == "SuperAdmin"; }
    function isManagerOrAbove() { return isAuth() && role() in ["Manager", "Admin", "SuperAdmin"]; }
    function hasModule(m) {
      return isAuth() && (
        isSuperAdmin() ||
        (request.auth.token.perms is list && m in request.auth.token.perms)
      );
    }

    // Job card / inspection-report PDFs (see src/lib/pdf.ts's
    // downloadJobCardPDF and src/lib/job.ts's Job.documents). Read is any
    // signed-in staff member (matches the `jobs` Firestore collection's own
    // read rule); write is scoped the same way job-intake writes to
    // Firestore are — the point is a job-card PDF can only ever be
    // (re)generated by someone who could also edit the underlying job.
    match /jobs/{jobId}/documents/{fileName} {
      allow read:  if isAuth();
      allow write: if hasModule("jobs") && (isManagerOrAbove() || role() == "Advisor");
    }

    // Inspection photos and signature PNGs (see src/lib/inspection.ts's
    // Photo/CustomerSignature/InspectorSignature and the storage-path
    // comments on them). Read matches every other staff-facing document in
    // this app — any signed-in staff member. Write is gated the same way the
    // `inspections` Firestore collection's own create/update rules are
    // (firestore.rules), PLUS a cross-service check against that same
    // document: once the inspection has reached "signed" or "superseded" no
    // more evidence can be added or replaced, mirroring the Firestore-side
    // immutability rule instead of relying on the UI alone to keep photos
    // and signatures in sync with a frozen document.
    match /jobs/{jobId}/inspections/{inspectionId}/{fileName=**} {
      allow read:  if isAuth();
      allow write: if hasModule("inspection") && (isManagerOrAbove() || role() in ["Advisor", "Technician"])
                   && (!firestore.exists(/databases/(default)/documents/inspections/$(inspectionId))
                       || firestore.get(/databases/(default)/documents/inspections/$(inspectionId)).data.status
                          in ["draft", "pending_acknowledgment"]);
    }

    // Everything else: no app feature uses Cloud Storage outside the above.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
