rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Identity ──────────────────────────────────────────────────────────
    // `role` and `perms` are custom claims set via adminAuth.setCustomUserClaims
    // (see syncAuthUser in src/server/staff-admin.ts) whenever a staff account
    // is created or edited -- not re-minted per login, since login itself is a
    // plain client-side signInWithEmailAndPassword with no server involved.
    // updateStaffFn revokes refresh tokens so a demoted user cannot keep
    // trading on a stale claim.
    function isAuth()            { return request.auth != null; }
    function role()              { return request.auth.token.role; }

    // ── Seniority ─────────────────────────────────────────────────────────
    // Defined once so a new tier propagates everywhere. Never restate these
    // role names inline — write `isManagerOrAbove() || role() in [peers]`.
    function isSuperAdmin()      { return isAuth() && role() == "SuperAdmin"; }
    function isAdmin()           { return isAuth() && role() in ["Admin", "SuperAdmin"]; }
    function isManagerOrAbove()  { return isAuth() && role() in ["Manager", "Admin", "SuperAdmin"]; }

    // ── Module access ─────────────────────────────────────────────────────
    // A SuperAdmin implicitly holds every module, so revoking one can never
    // lock the business out of its own user management.
    function hasModule(m) {
      return isAuth() && (
        isSuperAdmin() ||
        (request.auth.token.perms is list && m in request.auth.token.perms)
      );
    }

    // ── Staff ─────────────────────────────────────────────────────────────
    // DRAFTED + TESTED, NOT YET DEPLOYED (see
    // [[project_firestore_rules_audit]] Finding 1 and
    // [[project_firestore_rules_deploy_2026_09_05]]). Findings 2/4/5 shipped
    // 2026-09-05; this one was deliberately held back from that deploy
    // because owner-only read breaks access-panel.tsx's Staff & Access list
    // for every Manager+ until the app itself is redeployed with the fix
    // already written in this session's code (staff_public read instead of
    // bulk staff read, plus createStaffFn/updateStaffFn now writing
    // `permissions` onto staff_public, plus
    // scripts/migrate-staff-public-permissions.ts to backfill existing
    // accounts). This file holds the TARGET rule below; deploy the app
    // FIRST, then run `npm run deploy:rules` again to actually ship this.
    //
    // Reasoning: this doc holds `pinHash` (bcrypt) plus the offline-unlock
    // AES-GCM blob fields, and Firestore has no field-level read restriction
    // -- reading the doc at all means downloading those, whether the
    // caller's code uses them or not. A 4-digit PIN space is brute-forceable
    // offline from a bcrypt hash in minutes, so the Manager+ grant this
    // replaces let any Manager read (and offline-crack) every other staff
    // member's PIN, including superiors' -- a Manager -> SuperAdmin
    // escalation path.
    match /staff/{staffId} {
      allow read: if isAuth() && request.auth.uid == staffId;
      allow write: if false;
    }

    // Public staff list (name, username, role, color, active — never pinHash).
    // Unauthenticated reads are intentional: the login screen is a staff
    // picker and must show this roster before anyone is signed in.
    match /staff_public/{staffId} {
      allow read:  if true;
      allow write: if false; // Admin SDK only
    }

    // Username → staffId index, used server-side (Admin SDK only) to enforce
    // username uniqueness on staff create/delete. Login itself no longer
    // resolves through this index (it derives a Firebase Auth email straight
    // from the typed username instead); no client ever needs it, and
    // exposing it would re-open the employee enumeration hole that
    // staff_public used to have.
    match /usernames/{username} {
      allow read, write: if false;
    }

    // Enrolled tills for offline PIN login (see src/lib/offline-auth.ts).
    // Holds only label/audit metadata -- never a secret, so any signed-in
    // user may read it (a till needs to check its own revoked flag). Written
    // exclusively by src/server/devices.ts via the Admin SDK.
    match /devices/{deviceId} {
      allow read:  if isAuth();
      allow write: if false;
    }

    // Persistent auto-resume sessions (see src/server/sessions.ts). Doc id is
    // a sha256 hash of the session token, never the raw token itself, but the
    // doc is still session metadata a client has no business reading or
    // writing directly -- Admin SDK only, same as usernames/{username}.
    match /sessions/{sessionId} {
      allow read, write: if false;
    }

    // ── Audit log ─────────────────────────────────────────────────────────
    // Append-only. No updates or deletes — ever. A create must be attributed
    // to the caller's own uid, so no staff member can forge log lines in a
    // colleague's name. TIGHTENED (see [[project_firestore_rules_audit]]
    // Finding 5, deployed [[project_firestore_rules_deploy_2026_09_05]]) --
    // the attribution check
    // alone didn't constrain the logged CONTENT at all: a caller could
    // attribute an entry to themselves honestly and still write `action`/
    // `entity` as anything (wrong type, empty, garbage), which would corrupt
    // the one place this app's own security/access history is read from.
    // Now requires the shape store.tsx's logAudit() always writes; `before`/
    // `after` stay untyped (they're genuinely `unknown`, and can legitimately
    // be null), just required present.
    match /audit/{logId} {
      allow read:   if isManagerOrAbove();
      allow create: if isAuth() && request.resource.data.staffId == request.auth.uid
                    && request.resource.data.staffName is string
                    && request.resource.data.action is string && request.resource.data.action.size() > 0
                    && request.resource.data.entity is string && request.resource.data.entity.size() > 0
                    && request.resource.data.entityId is string
                    && request.resource.data.createdAt is string
                    && request.resource.data.keys().hasAll(
                         ["staffId", "staffName", "action", "entity", "entityId", "before", "after", "createdAt"]);
      allow update, delete: if false;
    }

    // ── Sequential-ID counters ────────────────────────────────────────────
    // counters/{name} holds { next: N } for the INV-/J-/B-/PO- sequences,
    // allocated in a client transaction so two tills can never mint the same
    // id. Contains nothing sensitive; any signed-in user who may create the
    // underlying document needs to bump its counter.
    match /counters/{counterId} {
      allow read:           if isAuth();
      allow create, update: if isAuth() && request.resource.data.next is int
                            && request.resource.data.next > 0;
      allow delete:         if false;
    }

    // ── Settings ──────────────────────────────────────────────────────────
    // Every signed-in user reads settings (business info, booking rules)
    // regardless of module access — the POS and booking flows depend on them.
    match /settings/{settingId} {
      allow read:  if isAuth();
      allow write: if isManagerOrAbove() && hasModule("settings");
    }

    // ── Invoices ──────────────────────────────────────────────────────────
    // TIGHTENED (see [[project_firestore_rules_audit]] Finding 2, deployed
    // [[project_firestore_rules_deploy_2026_09_05]]). Was: create/update
    // gated on role/module only, no field validation at all -- a Cashier
    // could set total/status/payments to anything via the same client SDK
    // the app already loads, including
    // marking an invoice Paid with no real payment, or a bare Manager-only
    // UI gate on refunds that this rule never actually enforced. Every
    // legitimate write path (store.tsx's addInvoice/recordInvoicePayment/
    // refundInvoicePayment/voidInvoice) always setDoc()s the FULL document
    // with total/subtotal/lines carried through unchanged from the existing
    // doc, so this does not break any of them -- verified against their
    // current implementations before drafting this.
    match /invoices/{invoiceId} {
      allow read: if hasModule("pos") && (isManagerOrAbove() || role() in ["Cashier", "Advisor"]);

      allow create: if hasModule("pos") && (isManagerOrAbove() || role() in ["Cashier", "Advisor"])
                    && request.resource.data.status == "Issued"
                    && request.resource.data.total is number && request.resource.data.total >= 0
                    && request.resource.data.subtotal is number && request.resource.data.subtotal >= 0;

      // Core sale content is immutable once created -- an update may only
      // append to payments/refunds and move status, never rewrite what was
      // actually sold or for how much. Refunding (moving status to
      // "Refunded") now requires Manager+ HERE, not just in the UI, closing
      // the exact gap the old comment on this block only ever hoped the UI
      // would cover.
      allow update: if hasModule("pos") && (isManagerOrAbove() || role() in ["Cashier", "Advisor"])
                    && request.resource.data.total == resource.data.total
                    && request.resource.data.subtotal == resource.data.subtotal
                    && request.resource.data.lines == resource.data.lines
                    && request.resource.data.get('payments', []).size() >= resource.data.get('payments', []).size()
                    && request.resource.data.get('refunds', []).size() >= resource.data.get('refunds', []).size()
                    && (request.resource.data.status != "Refunded" || isManagerOrAbove());

      allow delete: if isAdmin();
    }

    // ── Expenses ──────────────────────────────────────────────────────────
    match /expenses/{expenseId} {
      allow read:   if isAuth();
      allow create: if hasModule("pos") && (isManagerOrAbove() || role() == "Cashier");
      allow update: if hasModule("pos") && isManagerOrAbove();
      allow delete: if isAdmin();
    }

    // ── Bookings ──────────────────────────────────────────────────────────
    match /bookings/{bookingId} {
      allow read:   if isAuth();
      allow create: if hasModule("bookings") && (isManagerOrAbove() || role() == "Advisor");
      allow update: if hasModule("bookings") && (isManagerOrAbove() || role() == "Advisor");
      allow delete: if isManagerOrAbove();
    }

    // ── Jobs ──────────────────────────────────────────────────────────────
    // The work record (see src/lib/job.ts) — Booking above is still just
    // "the promise". Only POS checkout writes these today: a walk-in sale
    // synthesizes one, or transitions an existing job to delivered.
    // Check-in/technician-facing transitions are a later stage, so this
    // stays scoped to what's actually used rather than opened up ahead of
    // need.
    match /jobs/{jobId} {
      allow read:   if isAuth();
      allow create, update: if hasModule("pos") && (isManagerOrAbove() || role() in ["Cashier", "Advisor"]);
      allow delete: if isManagerOrAbove();
    }

    // Append-only transition log — same pattern as `audit`: no update or
    // delete, ever, and a create must be attributed to the caller's own uid
    // so no staff member can forge an event in a colleague's name. TIGHTENED
    // (see [[project_firestore_rules_audit]] Finding 5, deployed
    // [[project_firestore_rules_deploy_2026_09_05]]) -- same
    // gap as `audit` above: attribution alone didn't constrain the logged
    // content. Now requires the shape job.ts's buildTransitionEvent() always
    // produces; `fromStatus`/`note` stay untyped beyond key presence (both
    // are legitimately nullable -- fromStatus is null only for the creation
    // event, note is optional).
    match /jobEvents/{eventId} {
      allow read:   if isAuth();
      allow create: if hasModule("pos") && (isManagerOrAbove() || role() in ["Cashier", "Advisor"])
                    && request.resource.data.actorId == request.auth.uid
                    && request.resource.data.actorName is string
                    && request.resource.data.jobId is string && request.resource.data.jobId.size() > 0
                    && request.resource.data.toStatus is string && request.resource.data.toStatus.size() > 0
                    && request.resource.data.at is string
                    && request.resource.data.keys().hasAll(
                         ["jobId", "fromStatus", "toStatus", "actorId", "actorName", "at", "note"]);
      allow update, delete: if false;
    }

    // ── Customers ─────────────────────────────────────────────────────────
    match /customers/{customerId} {
      allow read:   if isAuth();
      allow create: if hasModule("customers") && (isManagerOrAbove() || role() in ["Advisor", "Cashier"]);
      allow update: if hasModule("customers") && (isManagerOrAbove() || role() in ["Advisor", "Cashier"]);
      allow delete: if isManagerOrAbove();
    }

    // ── Vehicles ──────────────────────────────────────────────────────────
    // First-class vehicle entity (plate/make/model/year/colour/size class),
    // superseding the embedded Customer.vehicles[] array. Piggybacks on the
    // "customers" module rather than a new one, same as coupons below — not
    // worth its own nav entry. Doc id is random, NOT the plate: plates can
    // be re-registered/corrected, and Firestore doc ids are immutable, so
    // every reference (Job, Booking, StockMovement, ...) points at this id,
    // never at the plate itself.
    //
    // Read is gated on the "customers" module for all three collections
    // below (vehicles, plates, vehicleOwnerships), not bare isAuth(): the
    // doc id on `plates` *is* the plate, so isAuth() there would let any
    // authenticated account enumerate every plate on file, and
    // vehicleOwnerships directly links a plate to a customer — an equally
    // real exposure gated the same way for the same reason.
    match /vehicles/{vehicleId} {
      allow read:   if hasModule("customers");
      allow create, update: if hasModule("customers");
      allow delete: if hasModule("customers") && isManagerOrAbove();
    }

    // plates/{normalizedPlate} -> { vehicleId } index, mirroring the
    // usernames/{username} -> staffId pattern above structurally (a
    // human-readable key resolved to an internal id), same module gating as
    // vehicles itself — see the note above.
    match /plates/{plate} {
      allow read:   if hasModule("customers");
      allow create, update: if hasModule("customers");
      allow delete: if hasModule("customers") && isManagerOrAbove();
    }

    // Ownership history: many-to-many between vehicles and customers over
    // time. Same module gating as vehicles itself.
    match /vehicleOwnerships/{ownershipId} {
      allow read:   if hasModule("customers");
      allow create, update: if hasModule("customers");
      allow delete: if hasModule("customers") && isManagerOrAbove();
    }

    // ── Coupons ───────────────────────────────────────────────────────────
    // Read is open to any signed-in user so POS checkout (Cashier/Advisor)
    // can validate a code. Creating/deleting coupon terms is a Manager+
    // action. TIGHTENED (see [[project_firestore_rules_audit]] Finding 4,
    // deployed [[project_firestore_rules_deploy_2026_09_05]]) -- update used
    // to be open to any customers-module holder
    // for every field, not just the redemption bump the comment claimed:
    // the UI (_app.customers.tsx CouponsPanel) already gates full edits and
    // the active toggle behind Manager+ (`canManage`), so a non-Manager
    // customers-module holder (e.g. a default-permissioned Advisor) could
    // previously bypass that UI gate via the client SDK directly and rewrite
    // a coupon's discount value/type/expiry/active. Now a non-Manager update
    // may only grow `redeemedCount` (the real checkout-redemption write,
    // store.tsx's addInvoice batch) with every other field held identical;
    // Manager+ keeps full update rights for the edit form / active toggle.
    match /coupons/{couponId} {
      allow read:   if isAuth();
      allow create: if hasModule("customers") && isManagerOrAbove();
      allow update: if hasModule("customers")
                    && (isManagerOrAbove() ||
                        (request.resource.data.code == resource.data.code
                          && request.resource.data.type == resource.data.type
                          && request.resource.data.value == resource.data.value
                          && request.resource.data.active == resource.data.active
                          && request.resource.data.expiresAt == resource.data.expiresAt
                          && request.resource.data.maxRedemptions == resource.data.maxRedemptions
                          && request.resource.data.redeemedCount > resource.data.redeemedCount));
      allow delete: if hasModule("customers") && isManagerOrAbove();
    }

    // ── Services ──────────────────────────────────────────────────────────
    match /services/{serviceId} {
      allow read:  if isAuth();
      allow write: if isManagerOrAbove() && hasModule("settings");
    }

    // ── Inventory ─────────────────────────────────────────────────────────
    // TIGHTENED (see [[project_firestore_rules_audit]] Finding 4, deployed
    // [[project_firestore_rules_deploy_2026_09_05]]) -- was: any
    // inventory-module holder (e.g. a default-permissioned
    // Advisor) could edit every field via the client SDK, including cost/
    // supplier/reorder-threshold/name, with no UI gate at all (unlike
    // coupons, which already gated this in the UI). Decision: restrict full
    // edits to Manager+ here AND add a matching UI gate in _app.inventory.tsx
    // (done alongside this change). Non-Managers keep exactly what the old
    // comment always claimed was the intent -- adjusting `stock` (and the
    // `lastUpdated` timestamp that always accompanies it) via the Adjust
    // widget's store.tsx adjustStock(), nothing else.
    match /inventory/{itemId} {
      allow read:   if isAuth();
      allow create: if hasModule("inventory") && isManagerOrAbove();
      allow update: if hasModule("inventory")
                    && (isManagerOrAbove() ||
                        (request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(["stock", "lastUpdated"])));
      allow delete: if hasModule("inventory") && isManagerOrAbove();
    }

    // ── Equipment & Maintenance ───────────────────────────────────────────
    match /equipment/{equipmentId} {
      allow read:  if isAuth();
      allow write: if hasModule("equipment") && isManagerOrAbove();
    }

    match /maintenanceLogs/{logId} {
      allow read:   if isAuth();
      allow create: if hasModule("equipment");
      allow update: if hasModule("equipment") && isManagerOrAbove();
      allow delete: if isAdmin();
    }

    // ── Purchase Orders ───────────────────────────────────────────────────
    match /purchaseOrders/{poId} {
      allow read:   if hasModule("purchase-orders");
      allow create: if hasModule("purchase-orders") && isManagerOrAbove();
      allow update: if hasModule("purchase-orders") && isManagerOrAbove();
      allow delete: if isAdmin();
    }

    // ── Notifications ─────────────────────────────────────────────────────
    match /sentNotifications/{notifId} {
      allow read:   if hasModule("notifications") && isManagerOrAbove();
      allow create: if hasModule("notifications");
      allow update, delete: if false;
    }

    // ── Leads (contact/booking inquiries from the public polishstation.lk
    //    marketing site) ────────────────────────────────────────────────────
    // Written exclusively by the Admin SDK from the unauthenticated
    // src/routes/api.public.*.ts routes, which bypasses these rules entirely
    // by design — that's how an anonymous site visitor is able to create one
    // at all. `create` is false here for everyone else. Staff triage (status
    // changes, convert-to-customer) is a normal authenticated client write,
    // gated behind the new "leads" module like every other staff-facing list.
    match /leads/{leadId} {
      allow read:   if hasModule("leads");
      allow create: if false;
      allow update: if hasModule("leads");
      allow delete: if hasModule("leads") && isManagerOrAbove();
    }

    // Doc id = email, so the public newsletter route's upsert is idempotent.
    // No staff UI mutates this collection yet, so writes stay Admin-SDK-only.
    match /newsletterSubscribers/{subscriberId} {
      allow read:  if hasModule("leads");
      allow write: if false;
    }
  }
}
